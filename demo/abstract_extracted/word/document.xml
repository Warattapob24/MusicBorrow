fice/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="062A9DF3" w14:textId="77777777" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:r><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">การพัฒนาระบบการยืม – คืน เครื่องดนตรี โดยใช้เว็บแอปพลิเคชัน </w:t></w:r><w:r><w:t>Music Borrow</w:t></w:r></w:p><w:p w14:paraId="2BFA336B" w14:textId="77777777" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:r><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">โรงเรียนโนนไทยคุรุอุปถัมภ์ สังกัดองค์การบริหารส่วนจังหวัดนครราชสีมา </w:t></w:r></w:p><w:p w14:paraId="38936CEC" w14:textId="77777777" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:proofErr w:type="spellStart"/><w:r><w:rPr><w:cs/></w:rPr><w:t>วรัท</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r><w:rPr><w:cs/></w:rPr><w:t>ภพ ทุมนาหาด</w:t></w:r></w:p><w:p w14:paraId="24AB3919" w14:textId="0AC67B42" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:r><w:rPr><w:cs/></w:rPr><w:t>ชุมนุมดนตรีสากล โรงเรียนโนนไทยคุรุอุปถัมภ์ สังกัดองค์การบริหารส่วนจังหวัดนครราชสีมา</w:t></w:r></w:p><w:p w14:paraId="32154B50" w14:textId="77777777" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:pPr><w:rPr><w:rFonts w:hint="cs"/></w:rPr></w:pPr></w:p><w:p w14:paraId="57BA41B5" w14:textId="2BE6209B" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:pPr><w:jc w:val="center"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="0098308A"><w:rPr><w:b/><w:bCs/><w:cs/></w:rPr><w:t>บทคัดย่อ</w:t></w:r></w:p><w:p w14:paraId="1F779D7D" w14:textId="77777777" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:pPr><w:jc w:val="center"/><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr></w:p><w:p w14:paraId="14DA08EC" w14:textId="6BB96ED7" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:pPr><w:ind w:firstLine="720"/><w:jc w:val="thaiDistribute"/></w:pPr><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">การวิจัยครั้งนี้มีวัตถุประสงค์เพื่อ </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">1) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">เพื่อพัฒนาระบบการยืม–คืน เครื่องดนตรี โดยใช้เว็บแอปพลิเคชัน </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">Music Borrow </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">โรงเรียนโนนไทยคุรุอุปถัมภ์ สังกัดองค์การบริหารส่วนจังหวัดนครราชสีมา </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">2) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>เพื่อประเมินความพึงพอใจของนักเรียนชุมนุมดนตรีสากลที่มีต่อระบบการยืม-คืนโดยใช้เว็บแอ</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="cs"/><w:cs/></w:rPr><w:t>ป</w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">พลิเคชัน </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">Music Borrow </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">โรงเรียนโนนไทยคุรุอุปถัมภ์ สังกัดองค์การบริหารส่วนจังหวัดนครราชสีมา กลุ่มตัวอย่างที่ใช้การวิจัย คือนักเรียนชุมนุมดนตรีสากล จำนวน  </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">50 </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>คน โรงเรียนโนนไทยคุรุอุปถัมภ์ สังกัดองค์การบริหารส่วนจังหวัดนคราชสีมา แบบเจาะจง (</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">Purposive sampling) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">เครื่องมือในการวิจัยครั้งนี้ ระบบฐานข้อมูลระบบการยืม-คืน โดยใช้ผ่านแอปพลิเคชัน </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">Music Borrow </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">แบบสอบถามผู้เชี่ยวชำญเพื่อตรวจสอบประสิทธิภาพ แบบสอบถามความพึงพอใจต่อการใช้งาน การวิเคราะห์ข้อมูลได้แก่ ค่าเฉลี่ยเลขคณิต ร้อยละ ส่วนเบี่ยงเบนมาตรฐาน คำนวณค่าประสิทธิภาพ </w:t></w:r></w:p><w:p w14:paraId="4FDEBF39" w14:textId="633D2E68" w:rsidR="0098308A" w:rsidRDefault="0098308A" w:rsidP="0098308A"><w:pPr><w:ind w:firstLine="720"/></w:pPr><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">ผลการวิจัยพบว่า </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">1) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">ระบบข้อมูลการยืม - คืน เครื่องดนตรี โดยใช้เว็บแอปพลิเคชัน </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">Music Borrow </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>โรงเรียนโนนไทยคุรุอุปถัมภ์ ที่ผู้วิจัยพัฒนาขึ้น มีความเหมาะสมและประสิทธิภาพตามการประเมินของผู้เชี่ยวชาญอยู่ในระดับมากที่สุด (</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t>x</w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>̄</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve"> = 4.86, S.D. = 0.21) 2) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>ผลการประเมินระดับความพึงพอใจของนักเรียนกลุ่มตัวอย่าง ที่มีต่อการใช้งานระบบในภาพรวมอยู่ในระดับมากที่สุด (</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t>x</w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>̄</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve"> = 4.54, S.D. = 0.62) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>โดยด้านการบูรณาการเกม</w:t></w:r><w:proofErr w:type="spellStart"/><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>มิฟิ</w:t></w:r><w:proofErr w:type="spellEnd"/><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>เคชัน และแรงจูงใจมีค่าเฉลี่ยสูงที่สุด (</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t>x</w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>̄</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve"> = 4.56) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>รองลงมาคือด้านการส่งเสริมวินัยและการกำกับตนเอง (</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t>x</w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>̄</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve"> = 4.54) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>และด้านประสิทธิภาพและการออกแบบระบบ (</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t>x</w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/></w:rPr><w:t>̄</w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve"> = 4.52) </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t xml:space="preserve">ตามลำดับ ซึ่งสะท้อนให้เห็นว่าเว็บแอปพลิเคชัน </w:t></w:r><w:r w:rsidRPr="0098308A"><w:t xml:space="preserve">Music Borrow </w:t></w:r><w:r w:rsidRPr="0098308A"><w:rPr><w:cs/></w:rPr><w:t>สามารถนำไปใช้งานได้จริงอย่างมีประสิทธิภาพ ช่วยให้การดำเนินงานมีความสะดวก รวดเร็ว และถูกต้อง ตลอดจนสามารถกระตุ้นแรงจูงใจในการฝึกซ้อมดนตรีและส่งเสริมระเบียบวินัยในตนเองให้แก่นักเรียนได้เป็นอย่างดี</w:t></w:r></w:p><w:p w14:paraId="0000000A" w14:textId="77777777" w:rsidR="002B17EC" w:rsidRPr="0098308A" w:rsidRDefault="002B17EC" w:rsidP="0098308A"/><w:sectPr w:rsidR="002B17EC" w:rsidRPr="0098308A"><w:headerReference w:type="default" r:id="rId7"/><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1418" w:right="1418" w:bottom="1418" w:left="1985" w:header="709" w:footer="709" w:gutter="0"/><w:pgNumType w:start="1"/><w:cols w:space="720"/></w:sectPr></w:body></w:document>